# pre-release（リリース前）モード専用: マージ = 本番反映
#
# まだ実利用者がいない段階では、PR ごとの CI・staging 経由・デプロイ承認ゲートは
# 過剰保護（壊れても困る人がいない）。ローカルの pre-push hook（Tier 0）を第一防衛線とし、
# main へのマージで即プロダクション URL に上がる最短経路にする。
# 途中でエラーが出たら直して再マージすればよい。
#
# 本番リリース（実利用者が付く）のタイミングで released 構成に昇格する:
#   /infra-setup を再実行して product_stage=released を選ぶと、このファイルは削除され
#   ci.yml / deploy-staging.yml / deploy-production.yml（承認ゲート付き）/
#   weekly-full.yml 一式に置き換わる。
name: Deploy on Merge (pre-release)

on:
  push:
    branches: [main]
  workflow_dispatch:

env:
  VERCEL_ORG_ID: ${{ secrets.VERCEL_ORG_ID }}
  VERCEL_PROJECT_ID: ${{ secrets.VERCEL_PROJECT_ID }}
  NODE_VERSION: '{{NODE_VERSION}}'

concurrency:
  group: deploy-on-merge
  cancel-in-progress: true

jobs:
  deploy:
    name: Deploy to Production (no gate)
    runs-on: ${{ vars.CI_RUNNER || 'ubuntu-latest' }}
    steps:
      - uses: actions/checkout@v7

      - uses: actions/setup-node@v6
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: 'npm'

      - name: Install dependencies
        run: npm ci

      - name: Install Vercel CLI
        run: npm i -g vercel

      - name: Pull Vercel project settings
        run: vercel pull --yes --environment=production --token=${{ secrets.VERCEL_TOKEN }}

      - name: Build
        run: vercel build --prod --token=${{ secrets.VERCEL_TOKEN }}

      - name: Remove .git to bypass Vercel author check
        run: rm -rf .git

      - name: Deploy to Vercel (Production)
        id: deploy
        run: |
          DEPLOYMENT_URL=$(vercel deploy --prebuilt --prod --token=${{ secrets.VERCEL_TOKEN }})
          echo "url=$DEPLOYMENT_URL" >> "$GITHUB_OUTPUT"

      # デプロイ直後の軽い生存確認（200 以外なら fail してマージ主に知らせる）
      - name: Smoke check
        if: ${{ vars.PRODUCTION_DOMAIN != '' }}
        env:
          PRODUCTION_DOMAIN: ${{ vars.PRODUCTION_DOMAIN }}
        run: |
          URL="https://${PRODUCTION_DOMAIN}/"
          for i in $(seq 1 5); do
            STATUS=$(curl -s -o /dev/null -w "%{http_code}" -L --max-time 15 "$URL" || echo "000")
            echo "attempt $i: $URL -> $STATUS"
            if [ "$STATUS" = "200" ]; then
              echo "スモークチェック OK"
              exit 0
            fi
            sleep 10
          done
          echo "::error::スモークチェック失敗: $URL が 200 を返しません（最終: $STATUS）"
          exit 1

      - name: Summary
        env:
          DEPLOY_URL: ${{ steps.deploy.outputs.url }}
          PRODUCTION_DOMAIN: ${{ vars.PRODUCTION_DOMAIN }}
        run: |
          {
            echo "### Deploy on Merge Complete (pre-release mode)"
            echo "- Deployment: $DEPLOY_URL"
            if [ -n "$PRODUCTION_DOMAIN" ]; then
              echo "- Production: https://$PRODUCTION_DOMAIN"
            fi
          } >> "$GITHUB_STEP_SUMMARY"
