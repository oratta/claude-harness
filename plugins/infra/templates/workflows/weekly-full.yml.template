# 週次フルスイート — 省エネ CI 設計の Tier 3
#
# PR ごとの CI（ci.yml）は軽量チェックのみ。ここで週 1 回、フルスイート
# （build + 全テスト + npm audit + 任意で E2E）を回して drift を検知する。
# 本番デプロイ直前にも同等の preflight が走る（deploy-production.yml）ため、
# 「フルチェックが最後に走ってからリリースまでの空白」は最大でもデプロイ間隔にならない。
#
# 失敗時は issue を自動起票する（自律開発ループがあるプロジェクトでは agent が拾う）。
name: Weekly Full Suite

on:
  schedule:
    # 毎週月曜 06:00 JST（日曜 21:00 UTC）。週初めの作業開始前に結果が出ている状態にする
    - cron: "0 21 * * 0"
  workflow_dispatch:

env:
  NODE_VERSION: '{{NODE_VERSION}}'

permissions:
  contents: read
  issues: write

concurrency:
  group: weekly-full
  cancel-in-progress: false

jobs:
  full:
    name: Full Suite (tests + audit)
    runs-on: ${{ vars.CI_RUNNER || 'ubuntu-latest' }}
    # ジョブの上限時間（分）。無いと固まったジョブが 1 本 360 分まで走る。
    # 決め方: このリポジトリの週次実行の普段の所要時間（Actions の実行履歴）の約 2 倍。
    # 既定の 30 分は仮の値（フルスイートは PR 用より長い）。実測に合わせて書き換える
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v7

      - uses: actions/setup-node@v6
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: 'npm'

      - name: Install dependencies
        run: npm ci

      - name: Check migration version uniqueness
        run: npm run check:migrations --if-present

      # =================================================================
      # ▼▼▼ PROJECT-SPECIFIC OVERRIDE ▼▼▼
      # DB 疎通の統合テストを持つプロジェクトは、ここでローカル Supabase を起動して
      # .env.test を生成する（自分のリポジトリの同種のファイルを参照）。
      # supabase CLI はローカル開発と同一バージョンに固定すること（latest 禁止）。
      # =================================================================

      - name: Run ESLint
        run: npm run lint --if-present

      - name: Build (type check)
        run: npx next build
        env:
          NEXT_PUBLIC_SUPABASE_URL: ${{ secrets.NEXT_PUBLIC_SUPABASE_URL }}
          NEXT_PUBLIC_SUPABASE_ANON_KEY: ${{ secrets.NEXT_PUBLIC_SUPABASE_ANON_KEY }}
          NODE_OPTIONS: '--max-old-space-size=4096'

      - name: Run all tests
        run: npm run test:run --if-present

      # 依存脆弱性の定常スキャン。ブロッキングは本番依存（--omit=dev）のみ。
      # dev 依存は成果物に含まれず、「lockfile 側に修正版が存在しない dev の脆弱性」で
      # 無期限に赤くなり続けるため（2026-07-25 に suimei で実発生: GHSA-mh99-v99m-4gvg）。
      - name: npm audit (本番依存 / high・critical で fail)
        run: npm audit --omit=dev --audit-level=high

      # dev 依存の脆弱性は成果物に載らないためブロックしないが、放置しないよう
      # ログには必ず出す。上流が追従したらここが緑に戻る。
      - name: npm audit (dev 依存含む / 参考・非ブロッキング)
        continue-on-error: true
        run: npm audit --audit-level=high

      # Playwright E2E を持つプロジェクトは以下を有効化（PR CI ではなく週次に置く）
      # - name: Install Playwright browsers
      #   run: npx playwright install chromium --with-deps
      # - name: Run Playwright tests
      #   run: npx playwright test

      # セルフホストのランナーだけ、ジョブの終わりに作業ディレクトリ（GITHUB_WORKSPACE）配下を cwd にする
      # プロセスを止める。timeout-minutes での打ち切りや失敗・キャンセルでも always() で走る
      # （打ち切り後に実際に起動するかは、最初の打ち切りの run のログで確かめる）。
      # 止めるのは自分と祖先を除く cwd が作業ディレクトリ配下のプロセスだけ（同じ Mac のほかのジョブは止めない）。
      # cwd を作業ディレクトリの外へ移したプロセスは止まらない。作業ディレクトリを cwd にした常駐プロセスは置かないこと。
      # シグナルを送る直前に cwd を取り直し、作業ディレクトリ配下でなくなった PID（使い回しなど）には送らない。
      # 失敗は隠さない（止められない PID があるとき、lsof が非 0 で終わったときは赤になる）。
      # ci.yml と weekly-full.yml で同じ文面にする。
      - name: Clean up processes left in the workspace (self-hosted only)
        if: always() && runner.environment == 'self-hosted'
        run: |
          if ! command -v lsof >/dev/null 2>&1; then
            echo "lsof が無いため掃除できない" >&2
            exit 1
          fi
          ws="${GITHUB_WORKSPACE%/}"
          if [ -z "$ws" ]; then
            echo "GITHUB_WORKSPACE が空のため掃除できない" >&2
            exit 1
          fi
          # 自分自身とその祖先は止めない。親を PID 0 まで辿れなければ、祖先を止めるおそれがあるので何も送らずに失敗で終わる
          skip=" "
          p=$$
          n=0
          while [ -n "$p" ] && [ "$p" -gt 0 ] 2>/dev/null && [ "$n" -lt 64 ]; do
            skip="$skip$p "
            p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')
            n=$((n + 1))
          done
          if [ "$p" != 0 ]; then
            echo "祖先のプロセスを最後まで辿れなかったため掃除できない" >&2
            exit 1
          fi
          # cwd が作業ディレクトリと等しいか、その配下のプロセスを集める（前方一致だけの隣のディレクトリは除く）。
          # lsof が非 0 で終わったら、出力が空ならここで失敗、出力があれば出た分で掃除を続けて最後に失敗で終わる
          lsof_rc=0
          out=$(lsof -a -d cwd -F pn) || lsof_rc=$?
          if [ "$lsof_rc" -ne 0 ]; then
            if [ -z "$out" ]; then
              echo "lsof が失敗した（終了コード ${lsof_rc}）" >&2
              exit 1
            fi
            echo "lsof が終了コード $lsof_rc で終わった。出た分の一覧で掃除を続け、最後に失敗で終わる" >&2
          fi
          targets=""
          pid=""
          while IFS= read -r line; do
            case "$line" in
              p*) pid="${line#p}" ;;
              n*)
                case "${line#n}" in
                  "$ws" | "$ws"/*)
                    case "$skip$targets " in
                      *" $pid "*) ;;
                      *) targets="$targets $pid" ;;
                    esac
                    ;;
                esac
                ;;
            esac
          done <<< "$out"
          if [ -z "$targets" ]; then
            if [ "$lsof_rc" -ne 0 ]; then
              echo "一覧に止めるプロセスは無いが、lsof が失敗したので一覧が欠けているおそれがある" >&2
              exit 1
            fi
            echo "止めるプロセスは無い"
            exit 0
          fi
          # 消滅は ps -p で確かめる（kill -0 の失敗は権限拒否でも起きるので消滅とみなさない）
          alive() {
            for q in $1; do
              if ps -p "$q" >/dev/null 2>&1; then printf '%s ' "$q"; fi
            done
          }
          # $1=PID。cwd を取り直し、今も作業ディレクトリ配下なら in、外なら out、読めなければ unknown を出力する
          cwd_state() {
            o=$(lsof -a -d cwd -F pn -p "$1" 2>/dev/null) || o=""
            s=unknown
            while IFS= read -r l; do
              case "$l" in
                n*)
                  case "${l#n}" in
                    "$ws" | "$ws"/*) s=in ;;
                    *) s=out ;;
                  esac
                  break
                  ;;
              esac
            done <<< "$o"
            printf '%s' "$s"
          }
          # $1=PID の並び。送る直前に cwd を取り直し、今も作業ディレクトリ配下のものだけを出力する
          # （一覧のあとに終わって PID がほかのジョブのプロセスに使い回されたとき、そのプロセスへ送らないため）
          still_in() {
            for q in $1; do
              if [ "$(cwd_state "$q")" = in ]; then printf '%s ' "$q"; fi
            done
          }
          to=$(still_in "$targets")
          if [ -n "$to" ]; then
            echo "TERM を送る: $to"
            kill -TERM $to 2>/dev/null || echo "kill -TERM が失敗した対象がある（消滅は ps -p で確かめる）"
          fi
          left="$targets"
          i=0
          while :; do
            left=$(alive "$left")
            if [ -z "$left" ] || [ "$i" -ge 5 ]; then break; fi
            sleep 1
            i=$((i + 1))
          done
          to=$(still_in "$left")
          if [ -n "$to" ]; then
            echo "KILL を送る: $to"
            kill -KILL $to 2>/dev/null || echo "kill -KILL が失敗した対象がある（消滅は ps -p で確かめる）"
            sleep 1
          fi
          # 生き残った PID を仕分ける。cwd が今も配下なら止められなかった対象。cwd が外なら対象でなくなったもの
          # （PID の使い回しか cwd の移動）。cwd を読めないまま生きているものは確かめられないので失敗にする
          bad=""
          for q in $(alive "$left"); do
            case "$(cwd_state "$q")" in
              in) bad="$bad $q" ;;
              out) echo "PID $q は cwd が作業ディレクトリの外になったので対象から外した（シグナルは送っていない）" ;;
              *)
                if ps -p "$q" >/dev/null 2>&1; then
                  echo "PID $q は cwd を読めないので、作業ディレクトリ配下かを確かめられない" >&2
                  bad="$bad $q"
                fi
                ;;
            esac
          done
          if [ -n "$bad" ]; then
            echo "止められなかったプロセス:$bad" >&2
            exit 1
          fi
          if [ "$lsof_rc" -ne 0 ]; then
            echo "一覧の分は止めたが、lsof が失敗したので一覧が欠けているおそれがある" >&2
            exit 1
          fi
          echo "掃除完了"

  # 失敗したら issue を起票する（既に open の同種 issue があれば重複起票しない）
  report-failure:
    name: File issue on failure
    needs: full
    # full が timeout-minutes で打ち切られた（cancelled）ときも起票する。failure() だけだと拾えない
    if: ${{ always() && (needs.full.result == 'failure' || needs.full.result == 'cancelled') }}
    runs-on: ${{ vars.CI_RUNNER || 'ubuntu-latest' }}
    steps:
      - name: Create or skip issue
        env:
          GH_TOKEN: ${{ github.token }}
          REPO: ${{ github.repository }}
          RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
        run: |
          set -euo pipefail
          EXISTING=$(gh issue list --repo "$REPO" --state open --label "weekly-full-failure" --json number --jq 'length')
          if [ "$EXISTING" -gt 0 ]; then
            echo "既に open の weekly-full-failure issue があるためスキップ"
            exit 0
          fi
          gh label create "weekly-full-failure" --repo "$REPO" --color D93F0B \
            --description "週次フルスイートの失敗（自動起票）" 2>/dev/null || true
          gh issue create --repo "$REPO" \
            --title "週次フルスイートが失敗（フルテスト or audit）" \
            --label "weekly-full-failure" \
            --body "Weekly Full Suite が失敗しました。PR CI は軽量チェックのみのため、フルテストの回帰か依存脆弱性の可能性があります。ログ: $RUN_URL"
