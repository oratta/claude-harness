name: Migrate Production DB

on:
  workflow_dispatch:
    inputs:
      confirm:
        description: '本番マイグレーションを実行しますか？'
        required: true
        type: boolean
        default: false

concurrency:
  group: production-migrate
  cancel-in-progress: false

jobs:
  migrate:
    name: Run Supabase Migrations (Production)
    runs-on: ubuntu-latest
    environment:
      name: Production
    steps:
      - name: Validate confirmation
        if: ${{ github.event.inputs.confirm != 'true' }}
        run: |
          echo "::error::マイグレーションが確認されていません。confirm を true にしてください。"
          exit 1

      - uses: actions/checkout@v4

      - name: Setup Supabase CLI
        uses: supabase/setup-cli@v1
        with:
          version: latest

      - name: Link Supabase project (prod)
        env:
          SUPABASE_ACCESS_TOKEN: ${{ secrets.SUPABASE_ACCESS_TOKEN }}
        run: |
          supabase link --project-ref ${{ secrets.SUPABASE_PROD_REF }} --password "${{ secrets.SUPABASE_DB_PASSWORD_PROD }}"

      - name: Apply migrations
        env:
          SUPABASE_ACCESS_TOKEN: ${{ secrets.SUPABASE_ACCESS_TOKEN }}
          SUPABASE_DB_PASSWORD: ${{ secrets.SUPABASE_DB_PASSWORD_PROD }}
        run: |
          supabase db push --linked

      - name: Summary
        run: |
          echo "### Production Migration Applied" >> "$GITHUB_STEP_SUMMARY"
          echo "- Project Ref: ${{ secrets.SUPABASE_PROD_REF }}" >> "$GITHUB_STEP_SUMMARY"
          echo "- Applied migrations from supabase/migrations/" >> "$GITHUB_STEP_SUMMARY"
