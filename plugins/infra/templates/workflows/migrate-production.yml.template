name: Migrate Production DB

on:
  workflow_dispatch:
    inputs:
      confirm:
        description: '本番マイグレーションを実行しますか？'
        required: true
        type: boolean
        default: false

env:
  SUPABASE_ACCESS_TOKEN: ${{ secrets.SUPABASE_ACCESS_TOKEN }}
  PROD_SUPABASE_PROJECT_REF: ${{ secrets.PROD_SUPABASE_PROJECT_REF }}

concurrency:
  group: production-migrate
  cancel-in-progress: false

# 必要な Secrets:
# - SUPABASE_ACCESS_TOKEN: Management API 用（適用状況の確認）
# - PROD_SUPABASE_PROJECT_REF: 本番プロジェクトの ref
# - PROD_SUPABASE_DB_URL: Session Pooler の接続文字列（バックアップ / db push 用。
#   GitHub Actions runner は IPv4 のため pooler 経由必須）
#
# 通常運用（expand-contract の expand 側）:
#   このワークフローでマイグレーションを先に適用 → deploy-production.yml でデプロイ。
#   破壊的マイグレーションは deploy-production.yml の maintenance=true を使う
#   （メンテ表示＋書き込み停止つきで migrate + deploy が一括実行される）。

jobs:
  migrate:
    name: Run Supabase Migrations (Production)
    runs-on: ubuntu-latest
    environment:
      name: Production
    steps:
      - name: Validate confirmation
        if: ${{ github.event.inputs.confirm != 'true' }}
        run: |
          echo "::error::マイグレーションが確認されていません。confirm を true にしてください。"
          exit 1

      - uses: actions/checkout@v7

      - name: Setup Supabase CLI
        uses: supabase/setup-cli@v2
        with:
          version: latest

      # 適用前バックアップ（Free tier に PITR がないため必須）
      - name: Backup production database
        env:
          PROD_SUPABASE_DB_URL: ${{ secrets.PROD_SUPABASE_DB_URL }}
        run: |
          if [ -z "$PROD_SUPABASE_DB_URL" ]; then
            echo "::error::PROD_SUPABASE_DB_URL が未設定です。Session Pooler の接続文字列を GitHub Secrets に登録してください。"
            exit 1
          fi
          mkdir -p backup
          supabase db dump --db-url "$PROD_SUPABASE_DB_URL" -f backup/roles.sql --role-only
          supabase db dump --db-url "$PROD_SUPABASE_DB_URL" -f backup/schema.sql
          supabase db dump --db-url "$PROD_SUPABASE_DB_URL" -f backup/data.sql --data-only --use-copy

      - name: Upload backup artifact
        uses: actions/upload-artifact@v7
        with:
          name: db-backup-migrate-${{ github.run_id }}
          path: backup/
          retention-days: 30

      - name: Apply migrations
        env:
          PROD_SUPABASE_DB_URL: ${{ secrets.PROD_SUPABASE_DB_URL }}
        run: supabase db push --db-url "$PROD_SUPABASE_DB_URL" --include-all --yes

      # 適用結果の確認（Management API・DB パスワード不要）
      - name: Verify applied migrations
        run: |
          LOCAL=$(basename -a supabase/migrations/*.sql 2>/dev/null | grep -oE '^[0-9]+' | sort -u)
          REMOTE=$(curl -sf -X POST \
            "https://api.supabase.com/v1/projects/${PROD_SUPABASE_PROJECT_REF}/database/query" \
            -H "Authorization: Bearer ${SUPABASE_ACCESS_TOKEN}" \
            -H "Content-Type: application/json" \
            -d '{"query":"select version from supabase_migrations.schema_migrations order by version"}' \
            | jq -r '.[].version' | sort -u)
          PENDING=$(comm -23 <(echo "$LOCAL") <(echo "$REMOTE") | sed '/^$/d')
          if [ -n "$PENDING" ]; then
            echo "::error::適用後も未適用のマイグレーションが残っています: $(echo "$PENDING" | tr '\n' ' ')"
            exit 1
          fi
          echo "全マイグレーションが本番に適用されています。"

      - name: Summary
        run: |
          {
            echo "### Production Migration Applied"
            echo "- Project Ref: ${PROD_SUPABASE_PROJECT_REF}"
            echo "- Backup artifact: db-backup-migrate-${{ github.run_id }} (30日保持)"
            echo "- Applied migrations from supabase/migrations/"
          } >> "$GITHUB_STEP_SUMMARY"
