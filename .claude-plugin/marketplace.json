{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "oratta-claude-harness",
  "description": "Claude Code用スキル・プラグインのマーケットプレイス",
  "owner": {
    "name": "Oratta",
    "url": "https://github.com/oratta"
  },
  "plugins": [
    {
      "name": "worktree",
      "description": "Git worktree の作成時セットアップ（/wt-setup）と安全な後片付け（/wt-clean）を自動化する。",
      "source": "./plugins/worktree",
      "category": "workflow",
      "author": {
        "name": "Oratta"
      },
      "keywords": [
        "worktree",
        "git",
        "setup",
        "cleanup",
        "symlink"
      ]
    },
    {
      "name": "infra",
      "description": "Vercel + Supabase + GitHub Actions の local/staging/prod 環境を対話的に一括セットアップする（/infra-setup）。",
      "source": "./plugins/infra",
      "category": "workflow",
      "author": {
        "name": "Oratta"
      },
      "keywords": [
        "infra",
        "setup",
        "vercel",
        "supabase",
        "github-actions",
        "deploy",
        "nextjs"
      ]
    },
    {
      "name": "dev-workflow",
      "description": "issue か Draft PR を記録先に、仕様化・TDD 実装・レビュー・PR ゲートまでを回す標準開発ワークフロー（/develop）。",
      "source": "./plugins/dev-workflow",
      "category": "workflow",
      "author": {
        "name": "Oratta"
      },
      "keywords": [
        "dev-workflow",
        "github",
        "issue",
        "openspec",
        "opsx",
        "worktree",
        "tdd",
        "spec-driven"
      ]
    },
    {
      "name": "product-handover",
      "description": "プロダクトをエージェントに引き渡すときの法務ドラフト・インシデント対応手順書・サポート窓口・教訓ログの雛形集。",
      "source": "./plugins/product-handover",
      "category": "workflow",
      "author": {
        "name": "Oratta"
      },
      "keywords": [
        "product-handover",
        "handover",
        "legal-drafts",
        "support-desk",
        "autonomy-lessons",
        "template"
      ]
    },
    {
      "name": "capability-registry",
      "description": "外部サービスを操作する前に、使える CLI と認証トークンの在処を案内する索引スキル。",
      "source": "./plugins/capability-registry",
      "category": "workflow",
      "author": {
        "name": "Oratta"
      },
      "keywords": [
        "capability",
        "registry",
        "cli",
        "token",
        "1password",
        "discovery",
        "browser-guard"
      ]
    },
    {
      "name": "statusline",
      "description": "5h/7d のレート制限の消化率とペース、コンテキスト残量、API 換算コストを一目で出すステータスライン。",
      "source": "./plugins/statusline",
      "category": "productivity",
      "author": {
        "name": "Oratta"
      },
      "keywords": [
        "statusline",
        "rate-limit",
        "usage",
        "quota",
        "ccusage",
        "claude-code"
      ]
    },
    {
      "name": "casting",
      "description": "意思決定を人に上げるか自走するかを観点ごとに決める「観点の配役」フレームワーク。",
      "source": "./plugins/casting",
      "category": "workflow",
      "author": {
        "name": "Oratta"
      },
      "keywords": [
        "casting",
        "decision-delegation",
        "perspective",
        "escalation",
        "catalog"
      ]
    },
    {
      "name": "cost-ledger",
      "description": "Claude Code の会話ログから、PR・issue ごとの API 換算コストを集計する（/cost）。",
      "source": "./plugins/cost-ledger",
      "category": "productivity",
      "author": {
        "name": "Oratta"
      },
      "keywords": [
        "cost",
        "usage",
        "attribution",
        "issue",
        "pull-request",
        "claude-code"
      ]
    }
  ],
  "skills": [],
  "bundles": [
    {
      "name": "all",
      "description": "全プラグインをインストール",
      "plugins": [
        "worktree",
        "infra",
        "dev-workflow",
        "product-handover",
        "statusline",
        "capability-registry",
        "casting",
        "cost-ledger"
      ],
      "skills": []
    }
  ]
}
