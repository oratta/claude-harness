{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "oratta-claude-harness",
  "version": "2.0.0",
  "description": "Claude Code用スキル・プラグインのマーケットプレイス",
  "owner": {
    "name": "Oratta",
    "url": "https://github.com/oratta"
  },
  "plugins": [
    {
      "name": "skill-aware-workflow",
      "description": "タスク実行前にスキルを探索し、実行中の摩擦を記録、完了後に新スキル作成を提案するワークフローシステム。",
      "source": "./plugins/skill-aware-workflow",
      "category": "workflow",
      "version": "1.0.0",
      "author": { "name": "Oratta" },
      "keywords": ["skill-discovery", "workflow", "learning", "automation"]
    },
    {
      "name": "obsidian-llm-session-rules",
      "description": "Obsidian LLM Session用のルールセット",
      "source": "./plugins/obsidian-llm-session-rules",
      "category": "productivity",
      "version": "1.1.1",
      "author": { "name": "Oratta" },
      "keywords": ["obsidian", "llm", "session", "context", "auto-save"]
    },
    {
      "name": "run",
      "description": "Claude Code 自律実行システム v4.5。Worktree安全性強化: コミット義務、順次作成、git merge必須、検証前削除禁止。",
      "source": "./plugins/run",
      "category": "workflow",
      "version": "4.5.0",
      "author": { "name": "Oratta" },
      "keywords": ["run", "autonomous", "execution", "agents", "openspec", "tdd", "feedback", "harness"]
    },
    {
      "name": "r",
      "description": "runプラグインの短縮コマンド。/r:p, /r:e, /r:s, /r:d, /r:a, /r:f",
      "source": "./plugins/r",
      "category": "workflow",
      "version": "4.0.0",
      "author": { "name": "Oratta" },
      "keywords": ["run", "alias", "shortcut"]
    },
    {
      "name": "weekly-report",
      "description": "週次プロジェクト実績レポートを自動生成する。",
      "source": "./plugins/weekly-report",
      "category": "productivity",
      "version": "1.0.0",
      "author": { "name": "Oratta" },
      "keywords": ["weekly", "report", "obsidian"]
    }
  ],
  "skills": [],
  "bundles": [
    {
      "name": "all",
      "description": "全プラグインをインストール",
      "plugins": ["skill-aware-workflow", "obsidian-llm-session-rules", "run", "r", "weekly-report"],
      "skills": []
    }
  ]
}
